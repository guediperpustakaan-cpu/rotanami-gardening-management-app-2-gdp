# PostgreSQL / Neon
# Untuk Neon, salin connection string dari konsol Neon.
# Contoh: postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# true untuk Neon dan host yang mewajibkan SSL.
# false untuk PostgreSQL lokal tanpa SSL.
DATABASE_SSL=true
